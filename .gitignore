# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.env.*
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# Node (if used)
node_modules/
npm-debug.log*

# HyperFrames renders are copied into assets/gallery after review.
videos/**/renders/

# API keys and secrets
*.key
*.pem
credentials.json
secrets.json

# Claude Code local overrides
CLAUDE.local.md

# Working files
*.tmp
*.bak
scratch/
proof/.cache/

# Social content (private drafts)
social/

# Client workspaces are private. Never commit a real client to this public repo.
# Only the fictional example workspace is tracked.
workspaces/*
!workspaces/example-acme-pm/
!workspaces/example-acme-pm/**

# Engine run outputs are per-client scratch. Only the fictional samples are tracked.
engine/data/*
!engine/data/*.sample.json
